{
  "name": "aincrad",
  "version": "0.5.0",
  "private": true,
  "description": "A local-first, mountain-ringed exploration game. The first foundation for a living world.",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "prestart": "npm run build",
    "start": "node scripts/start.mjs",
    "test": "node scripts/check.mjs",
    "check": "node scripts/check.mjs",
    "publish:github": "node scripts/publish-github.mjs",
    "bundle": "node scripts/bundle.mjs",
    "smoke": "npm run build && node scripts/start.mjs --smoke-test",
    "evaluate": "node scripts/evaluate-npc.mjs",
    "package:win": "npm run build && electron-builder --win zip --x64 --publish never",
    "package:linux": "npm run build && electron-builder --linux dir --x64 --publish never"
  },
  "productName": "Aincrad",
  "build": {
    "appId": "io.kumori.aincrad",
    "productName": "Aincrad",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false,
      "artifactName": "Aincrad-${version}-Windows-${arch}.zip"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Game"
    }
  },
  "devDependencies": {
    "electron-builder": "26.15.3",
    "electron": "44.7.0"
  }
}
